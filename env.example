# Copy to .env and fill in real values before running. Never commit .env.
# The INTEGRATIONHUB_* variables are read by the server binary.
# The POSTGRES_*/MONGO_*/REDIS_*/JWT_* variables are dev overrides for
# docker compose (compose.dev.yaml); copy to .env to change defaults.

INTEGRATIONHUB_DB_HOST=localhost
INTEGRATIONHUB_DB_PORT=5432
INTEGRATIONHUB_DB_USER=integrationhub
INTEGRATIONHUB_DB_PASSWORD=change-me
INTEGRATIONHUB_DB_NAME=integrationhub
INTEGRATIONHUB_MONGO_HOST=localhost
INTEGRATIONHUB_MONGO_PORT=27017
INTEGRATIONHUB_REDIS_ADDR=localhost:6379
INTEGRATIONHUB_REDIS_PASSWORD=change-me
INTEGRATIONHUB_NATS_URL=nats://localhost:4222
INTEGRATIONHUB_JWT_SECRET=change-me
INTEGRATIONHUB_JWT_TTL=1h
INTEGRATIONHUB_REFRESH_TTL=720h
INTEGRATIONHUB_ADMIN_API_KEY=
INTEGRATIONHUB_RBAC_POLICY=
INTEGRATIONHUB_RBAC_POLICY_FILE=

# OpenTelemetry tracing (disabled when endpoint is empty)
INTEGRATIONHUB_OTEL_ENDPOINT=
INTEGRATIONHUB_OTEL_INSECURE=true
INTEGRATIONHUB_OTEL_SAMPLE_RATIO=1.0
INTEGRATIONHUB_OTEL_SERVICE_NAME=integrationhub
INTEGRATIONHUB_SECRET_KEY=change-me-base64-32-bytes
INTEGRATIONHUB_SERVER_PORT=8080
INTEGRATIONHUB_LOG_LEVEL=info
INTEGRATIONHUB_RATE_PER_SEC=100
INTEGRATIONHUB_RATE_BURST=200
INTEGRATIONHUB_CORS_ORIGINS=
INTEGRATIONHUB_EXEC_WORKERS=4
INTEGRATIONHUB_EXEC_POLL_MS=1000

# docker compose dev overrides
POSTGRES_PASSWORD=devpassword
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=devpassword
REDIS_PASSWORD=devpassword
JWT_SECRET=dev-jwt-secret-change-me